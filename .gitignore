# Python bytecode from scripts/, which the Nix package copies wholesale into the
# store — a stale .pyc in a shipped artefact is worse than useless.
__pycache__/
*.pyc

# Nix build output.
result
result-*

# macOS writes one of these into every directory it has opened in Finder. Not
# ours, not the project's, and it will keep coming back — so it is ignored
# rather than deleted each time.
.DS_Store
